[Unit]
Description=Vehicul Avertizare Kiosk Browser
After=network.target network-online.target vehicul-alert.service
Wants=network-online.target vehicul-alert.service

[Service]
Type=simple
User=__USER__
Environment=DISPLAY=:0
Environment=XAUTHORITY=__USER_HOME__/.Xauthority
ExecStart=/bin/bash __APP_DIR__/scripts/vehicul-kiosk.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
