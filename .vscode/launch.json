{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: runserver",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "--noreload"],
      "django": true
    },
    {
      "name": "Django: teste (manage.py test)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["test", "-v", "2"],
      "django": true
    },
    {
      "name": "Drivere: python -m mcd.test",
      "type": "debugpy",
      "request": "launch",
      "module": "mcd.test",
      "cwd": "${workspaceFolder}"
    }
  ]
}
